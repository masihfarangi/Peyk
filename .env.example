# ---------------------------------------------------------------------------
# Peyk — environment configuration
#
# Copy to `.env` and fill in what you have. Every value is optional: with an
# empty file the app runs on OpenStreetMap tiles with mock routing and mock
# couriers, which is enough to exercise the whole flow.
#
# KEY SAFETY
#   Anything named VITE_* is compiled into the JavaScript bundle and is
#   therefore PUBLIC. Never put a secret here. See "Which keys are safe in the
#   browser?" in README.md.
# ---------------------------------------------------------------------------

# --- Map -------------------------------------------------------------------
# neshan = Neshan tiles (needs a web key) | osm = OpenStreetMap, no key needed
VITE_MAP_PROVIDER=osm

# Neshan *web* (map) key, from https://platform.neshan.org.
# PUBLIC by design — restrict it to your domain in the Neshan panel.
# Leave empty and the app falls back to OSM automatically.
VITE_MAP_API_KEY=

# Neshan map style: standard-day | standard-night | dreamy | dreamy-gold | osm-bright
VITE_MAP_TYPE=standard-day

# --- Routing ---------------------------------------------------------------
# osrm   = real street routing via routing.openstreetmap.de's free public bike
#          and foot profiles — no key needed (default; see OsrmRoutingService)
# mock   = no network, believable times but a curved-line geometry, not streets
# neshan = Neshan direction API, called straight from the browser
# proxy  = your own backend (the only production-safe option)
VITE_ROUTING_PROVIDER=osrm

# Neshan *service* key. NOT safe in the browser long term: use it for local
# development and demos, then move to VITE_ROUTING_PROVIDER=proxy.
VITE_ROUTING_API_KEY=

# Base URL of your routing proxy, e.g. https://api.example.com
# Required when VITE_ROUTING_PROVIDER=proxy.
VITE_ROUTING_PROXY_URL=

# --- Reverse geocoding (addresses instead of coordinates) ------------------
# none | neshan
VITE_GEOCODING_PROVIDER=none

# Defaults to VITE_ROUTING_API_KEY when left empty. Same warning applies.
VITE_GEOCODING_API_KEY=

# --- Location --------------------------------------------------------------
# Map centre before the first GPS fix. Default is Ferdowsi Square, Tehran.
VITE_DEFAULT_LAT=35.6997
VITE_DEFAULT_LNG=51.3380

# true = skip the real GPS and use the coordinates above.
# Useful on a desktop browser or an emulator with no location.
VITE_USE_MOCK_LOCATION=false

# --- Pricing -----------------------------------------------------------
# The whole fare formula (src/services/pricing/PricingService.ts):
#   Courier Pay    = MAX(Minimum Courier Pay,
#                        Base Pay + Distance(km) × Distance Rate
#                                 + Time(min) × Time Rate)
#   Customer Price = Courier Pay × (1 + Platform Commission), rounded to
#                     the nearest 1,000 Toman.
# This is the "admin settings" surface for pricing until there's a real
# backend — every number below can be tuned per deployment without touching
# application code.

# Toman. A trip's fare is never paid below this, however short.
VITE_PRICING_MIN_COURIER_PAY=25000

# Toman. The flat portion of every trip's fare.
VITE_PRICING_BASE_PAY=10000

# Toman per kilometre, applied to the mode's own routed distance.
VITE_PRICING_DISTANCE_RATE=4000

# Toman per minute, applied to the mode's own routed ETA.
VITE_PRICING_TIME_RATE=700

# 0.2 = 20% added on top of courier pay to get the customer-facing price.
VITE_PRICING_COMMISSION_RATE=0.2
